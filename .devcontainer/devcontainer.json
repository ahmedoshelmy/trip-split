{
  "name": "Trip Split",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "25", "jdkDistro": "tem" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": { "label": "Web (proxies the API)", "onAutoForward": "openBrowser" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "postCreateCommand": "./mvnw -q -B -DskipTests dependency:go-offline && npm ci --prefix web",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-boot-dev-pack", "ms-azuretools.vscode-docker", "dbaeumer.vscode-eslint"]
    }
  }
}
