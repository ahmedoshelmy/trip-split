# Copy to .env to override the compose defaults. Placeholder values only.
POSTGRES_USER=tripsplit
POSTGRES_PASSWORD=change-me
# Seed the invented "Dahab long weekend" trip on first start.
TRIPSPLIT_DEMO_DATA=false
# Port of the web UI on the host.
WEB_PORT=8090
# Origins allowed to open the WebSocket (comma separated patterns).
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
